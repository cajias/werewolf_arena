{
  "name": "werewolf_viewer",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "npm run build && http-server",
    "lint": "npm run lint:ts && npm run lint:md && npm run format:check",
    "lint:ts": "eslint index.ts",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore '**/node_modules/**' --ignore '**/CHANGELOG.md'",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --ignore '**/node_modules/**' --ignore '**/CHANGELOG.md' --fix",
    "format": "prettier --write '**/*.{html,json,md,ts}' --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check '**/*.{html,json,md,ts}' --ignore-path .gitignore --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.15.0",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-no-unsanitized": "4.1.4",
    "eslint-plugin-prettier": "5.5.0",
    "eslint-plugin-promise": "7.2.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-sonarjs": "3.0.5",
    "eslint-plugin-unicorn": "62.0.0",
    "http-server": "14.1.1",
    "markdownlint-cli": "0.46.0",
    "prettier": "3.7.1",
    "typescript": "5.4.5"
  }
}